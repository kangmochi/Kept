    "build": "npm run build -w app",
    "demo:sim": "evenhub-simulator http://localhost:5173 --automation-port 9898",
    "demo:auto": "node scripts/demo-automation.mjs"
  },
  "devDependencies": {
    "pngjs": "^7.0.0"
  }
}
