{
  "name": "kept",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "app",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "server": "npm run dev -w server",
    "start": "npm run start -w server",
