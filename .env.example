# Copy this file to .env at the repo root (or server/.env) and fill values locally.
# Never commit .env. Never paste these values into chat, screenshots, or the glasses app.
# The Vite app must not receive any of these keys.

# Local simulator only. Set to 0 on any hosted deploy.
# When 1, POST /pair {"code":"dev"} from loopback issues a session token.
ALLOW_DEV_PAIR=1

# How long a glasses pairing code stays valid, in seconds.
PAIRING_TTL_SECONDS=300

# Random string you generate yourself. Signs session tokens. Leave empty here.
SESSION_SECRET=

# Notion internal integration. The database "Keep — promises" already exists.
# Do not create a database from this app. Leave the title as-is.
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_ID=

# OpenAI-compatible chat completions. Default is Mistral.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=ministral-8b-2512

# OpenAI-compatible audio transcriptions. STT_API_KEY may equal LLM_API_KEY.
# Groq Whisper example (optional, env only): 
#   STT_BASE_URL=https://api.groq.com/openai/v1
#   STT_MODEL=whisper-large-v3-turbo
STT_BASE_URL=https://api.mistral.ai/v1
STT_API_KEY=
STT_MODEL=voxtral-mini-transcribe-3-0

PORT=8787
# Bind localhost so the demo is not exposed on the LAN. Use 0.0.0.0 only for an optional phone test.
HOST=127.0.0.1
TZ=Asia/Jakarta
